# BhonduFix Server-Side Environment Variables
# NEVER expose these in client-side code or commit .env.local to version control

# Google Gemini API Key (Recommended for Vision AI)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Alternative Vision Provider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
